      text-decoration: none;
      font-size: 0.8rem;
      padding: 0.35rem 0.7rem;
      border-radius: 4px;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .poly-return-bar .nav-links a:hover {
      background: var(--gold-glow);
      color: var(--gold-bright);
