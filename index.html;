    .federation-tabs button {
      background: transparent;
      border: 1px solid transparent;
      color: var(--muted);
      padding: 0.5rem 1rem;
      cursor: pointer;
      font-size: 0.85rem;
      border-radius: 4px;
      transition: all 0.2s;
      white-space: nowrap;
