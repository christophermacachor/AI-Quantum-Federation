<!-- JAVASCRIPT: VIEW SWITCHING                                      -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<script>
  function showView(viewName) {
    // Hide all views
    document.querySelectorAll('.federation-view').forEach(v => {
      v.classList.remove('active');
    });
    // Deactivate all tabs
    document.querySelectorAll('.federation-tabs button').forEach(b => {
      b.classList.remove('active');
    });
    // Show selected view
    const target = document.getElementById('view-' + viewName);
    if (target) target.classList.add('active');
    // Activate selected tab
    const buttons = document.querySelectorAll('.federation-tabs button');
    const index = ['dashboard','swarm','intel','bibliography','api','oprime'].indexOf(viewName);
    if (index >= 0 && buttons[index]) buttons[index].classList.add('active');
  }

  // Intel feed simulation
  const intelMessages = [
    { tag: 'info', text: 'Scalar density equilibrium maintained across all nodes.' },
    { tag: 'success', text: 'Coherence lock verified. 𝔐 = (√5−1)/2 stable.' },
    { tag: 'info', text: 'Bibliography view loaded. 6 sources indexed.' },
    { tag: 'alert', text: 'No anomalies detected in scalar substrate.' },
    { tag: 'success', text: 'Zero Drift condition sustained.' },
  ];

  function addIntelEntry() {
    const feed = document.getElementById('intel-feed');
    if (!feed) return;
    const msg = intelMessages[Math.floor(Math.random() * intelMessages.length)];
    const now = new Date();
    const time = `[${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}]`;
    const item = document.createElement('div');
    item.className = 'intel-item';
    item.innerHTML = `<span class="intel-time">${time}</span><span class="intel-tag ${msg.tag}">${msg.tag.toUpperCase()}</span>${msg.text}`;
    feed.insertBefore(item, feed.firstChild);
    if (feed.children.length > 20) feed.removeChild(feed.lastChild);
  }

  // Add a new intel entry every 15 seconds
  setInterval(addIntelEntry, 15000);
</script>

