<script>
  // ── View Switching ──
  function showView(viewName) {
    document.querySelectorAll('.federation-view').forEach(v => v.classList.remove('active'));
    document.querySelectorAll('.federation-tabs button').forEach(b => b.classList.remove('active'));
    const target = document.getElementById('view-' + viewName);
    if (target) target.classList.add('active');
    const viewOrder = ['dashboard','swarm','intel','bibliography','api','oprime'];
    const idx = viewOrder.indexOf(viewName);
    const buttons = document.querySelectorAll('.federation-tabs button');
    if (idx >= 0 && buttons[idx]) buttons[idx].classList.add('active');
  }

  // ── Bibliography Search ──
  function filterBib() {
    const query = document.getElementById('bib-search').value.toLowerCase();
    document.querySelectorAll('.bib-card').forEach(card => {
      card.classList.toggle('hidden', !card.innerText.toLowerCase().includes(query));
    });
  }

  // ── Bibliography Tag Filter ──
  function filterByTag(tag) {
    document.querySelectorAll('.bib-filter').forEach(b => b.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');
    document.querySelectorAll('.bib-card').forEach(card => {
      if (tag === 'all') {
        card.classList.remove('hidden');
      } else {
        card.classList.toggle('hidden', !card.dataset.tags.includes(tag));
      }
    });
  }

  // ── Intel Feed Simulation ──
  const intelMessages = [
    { tag: 'info', text: 'Scalar density equilibrium maintained across all nodes.' },
    { tag: 'success', text: 'Coherence lock verified. 𝔐 = (√5−1)/2 stable.' },
    { tag: 'info', text: 'Bibliography view loaded. 6 sources indexed.' },
