  <style>
    :root {
      --gold: #c8a04e;
      --gold-bright: #e8c870;
      --gold-dim: rgba(200,160,78,0.3);
      --gold-glow: rgba(200,160,78,0.15);
      --bg: #0a0a0f;
      --bg-card: rgba(0,0,0,0.4);
      --fg: #e0e0e0;
      --fg-bright: #f0e6d0;
      --muted: #8899aa;
      --accent: #c8a04e;
      --border: rgba(200,160,78,0.2);
      --success: #88ffaa;
      --warning: #ffcc66;
      --error: #ff6b6b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── Gold Navigation Bar (poly-return-bar) ── */
    .poly-return-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      background: rgba(10,10,15,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--gold-dim);
      padding: 0.6rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .poly-return-bar .nav-brand {
      color: var(--gold);
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 1px;
      text-decoration: none;
    }
    .poly-return-bar .nav-brand:hover { color: var(--gold-bright); }
    .poly-return-bar .nav-links {
      display: flex;
      gap: 0.3rem;
      align-items: center;
    }
    .poly-return-bar .nav-links a {
      color: var(--gold);
      text-decoration: none;
      font-size: 0.8rem;
      padding: 0.35rem 0.7rem;
      border-radius: 4px;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .poly-return-bar .nav-links a:hover {
      background: var(--gold-glow);
      color: var(--gold-bright);
    }

    /* ── Federation Header ── */
    .federation-header {
      margin-top: 50px;
      padding: 2rem 1.5rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--gold-dim);
    }
    .federation-header h1 {
      color: var(--gold);
      font-size: 1.6rem;
      margin-bottom: 0.3rem;
      letter-spacing: 2px;
    }
    .federation-header .subtitle {
      color: var(--muted);
      font-size: 0.85rem;
    }

    /* ── Federation Tabs ── */
    .federation-tabs {
      display: flex;
      justify-content: center;
      gap: 0.2rem;
      padding: 0.8rem 1rem;
      background: rgba(0,0,0,0.3);
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .federation-tabs button {
      background: transparent;
      border: 1px solid transparent;
      color: var(--muted);
      padding: 0.5rem 1rem;
      cursor: pointer;
      font-size: 0.85rem;
      border-radius: 4px;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .federation-tabs button:hover {
      color: var(--gold);
      border-color: var(--gold-dim);
    }
    .federation-tabs button.active {
      color: var(--gold);
      border-color: var(--gold);
      background: var(--gold-glow);
    }

    /* ── View Containers ── */
    .federation-view {
      display: none;
      padding: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
      animation: fadeIn 0.3s ease;
    }
    .federation-view.active { display: block; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── View Header ── */
    .view-header {
      text-align: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--gold-dim);
    }
    .view-header h2 {
      color: var(--gold);
      font-size: 1.4rem;
      margin-bottom: 0.3rem;
    }
    .view-header .view-subtitle {
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* ── Cards ── */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.2rem;
      margin-bottom: 1rem;
    }
    .card h3 {
      color: var(--fg-bright);
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }
    .card p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* ── Status Indicators ── */
    .status-dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      margin-right: 0.4rem;
    }
    .status-dot.online { background: var(--success); box-shadow: 0 0 6px var(--success); }
    .status-dot.warning { background: var(--warning); box-shadow: 0 0 6px var(--warning); }
    .status-dot.offline { background: var(--error); box-shadow: 0 0 6px var(--error); }

    /* ── Intel Feed ── */
    .intel-feed {
      max-height: 400px;
      overflow-y: auto;
    }
    .intel-item {
      padding: 0.7rem 0;
      border-bottom: 1px solid rgba(200,160,78,0.1);
      font-size: 0.85rem;
    }
    .intel-item:last-child { border-bottom: none; }
    .intel-time {
      color: var(--gold);
      font-size: 0.75rem;
      font-family: monospace;
      margin-right: 0.5rem;
    }
    .intel-tag {
      display: inline-block;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      font-size: 0.7rem;
      margin-right: 0.4rem;
    }
    .intel-tag.info { background: rgba(100,180,255,0.15); color: #88ccff; }
    .intel-tag.alert { background: rgba(255,100,100,0.15); color: #ff8888; }
    .intel-tag.success { background: rgba(100,255,150,0.15); color: #88ffaa; }

    /* ── Footer ── */
    .federation-footer {
      text-align: center;
      padding: 2rem 1rem;
      border-top: 1px solid var(--gold-dim);
      color: var(--muted);
      font-size: 0.8rem;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .poly-return-bar { flex-wrap: wrap; padding: 0.4rem 1rem; }
      .poly-return-bar .nav-links { gap: 0.1rem; }
      .poly-return-bar .nav-links a { padding: 0.25rem 0.4rem; font-size: 0.7rem; }
      .federation-header h1 { font-size: 1.2rem; }
      .federation-tabs { gap: 0.1rem; }
      .federation-tabs button { padding: 0.4rem 0.6rem; font-size: 0.75rem; }
    }
  </style>
