    { tag: 'info', text: 'Observer-observed coherence at nominal levels.' },
  ];
  function addIntelEntry() {
    const feed = document.getElementById('intel-feed');
    if (!feed) return;
    const msg = intelMessages[Math.floor(Math.random() * intelMessages.length)];
    const now = new Date();
    const time = `[${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}]`;
    const item = document.createElement('div');
    item.className = 'intel-item';
    item.innerHTML = `<span class="intel-time">${time}</span><span class="intel-tag ${msg.tag}">${msg.tag.toUpperCase()}</span>${msg.text}`;
    feed.insertBefore(item, feed.firstChild);
    if (feed.children.length > 20) feed.removeChild(feed.lastChild);
  }
  setInterval(addIntelEntry, 15000);
</script>

